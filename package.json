{
  "name": "burn-after-reading-chatroom",
  "version": "1.0.0",
  "private": true,
  "description": "阅后即焚的轻量级 P2P 私密聊天室：Node.js + Express + Socket.io 中转文本，WebRTC DataChannel 直传文件，纯内存无持久化",
  "keywords": [
    "chatroom",
    "socket.io",
    "webrtc",
    "p2p",
    "ephemeral"
  ],
  "license": "MIT",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "healthcheck": "node -e \"fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "4.21.2",
    "socket.io": "4.8.1"
  }
}
